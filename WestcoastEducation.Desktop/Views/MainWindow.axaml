<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WestcoastEducation.Desktop.ViewModels"
        xmlns:views="using:WestcoastEducation.Desktop.Views"
        x:Class="WestcoastEducation.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Westcoast Education - Administration"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryBrush}" Padding="20,14">
            <TextBlock Text="Westcoast Education - Administration"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource OnPrimaryBrush}" />
        </Border>

        <!-- En flik per område. Varje flik får sin egen ViewModel som DataContext. -->
        <TabControl Margin="12">
            <TabItem Header="Kurser">
                <views:CoursesView DataContext="{Binding Courses}" />
            </TabItem>
            <TabItem Header="Studenter">
                <views:StudentsView DataContext="{Binding Students}" />
            </TabItem>
            <TabItem Header="Lärare">
                <views:TeachersView DataContext="{Binding Teachers}" />
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>
