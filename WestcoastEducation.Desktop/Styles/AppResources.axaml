<!-- Applikationens färger. Används i views och styles via {DynamicResource ...},
     så att en färg kan ändras på ett ställe och uppdateras i hela applikationen. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBrush" Color="#1F4E79" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2E6DA4" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#D2453D" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F6F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D7DE" />

    <SolidColorBrush x:Key="TextBrush" Color="#1B1F24" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5A6470" />

</ResourceDictionary>
